module

public import New.Congruences.FirstOrder.FittingBlock

/-!
# Tied rows and the matrices of Ribet's method to first order

This file sets up Ribet's method to first order: the action of `O[X j][G]` through representations
and characters, the tie system (`TieSystem`), its tie ideal and tied rows. It then finds matrices of
tied rows with bounded determinant on the main summand, and matrices of tied rows that serve all
characters at once through Fitting ideals.

## Main definitions and results

* `New.Selmer.TieSystem`, `New.Selmer.TieSystem.tieIdeal`, `New.Selmer.TieSystem.tiedRows`: a
  6-field bundle `(u, p, τ, φ, ε, ρ₀)` defining the left ideal of `O[X j][G]` spanned by what every
  `u x` kills, `p I`, the relations that tie `τ k` to `φ k`, and `I ρ₀`, with `I` the augmentation
  ideal; and the rows whose element lies in it. The actions are `polyAction` and `polyChar`.
* `New.Selmer.TieSystem.exists_tiedRows_addVal_det_le`: the main summand, for the tied rows:
  matrices of tied rows whose determinant on the block is bounded by the length of a module of
  cocycles.
* `New.Selmer.TieSystem.exists_characterRows`: matrices of tied rows that serve all characters at
  once, together with the coefficient identity and valuation bound consumed by Ribet's lemma.

Notions from other files:
* `New.Selmer.fittingIdeal N`: the ideal of `R` generated by the determinants of square matrices
  with all rows in `N ⊆ R^ι`, the zeroth Fitting ideal of `R^ι / N`.
* `New.Selmer.ribetCocyclesIn u ρ B`: the cocycles `G → B^d` for `ρ` that obey the linear relations
  among the families `(u x g - 1)_x`.
* `New.Selmer.IsTraceIdeal` (`FittingBlock`): `S` holds the characteristic polynomials, and the
  `S`-module `𝒥` holds the traces of given relations.
* `New.Selmer.IsCharacterCocycle` (`FittingBlock`): a cocycle `c : G → O / p` for the character
  `χ` that obeys the linear relations among the `(u x g - 1)_x` and vanishes at the `δ v`; if
  `c γ = 0`, then every `χ g - 1` kills `c a`.
* `New.Selmer.IsDetectedBy` (`FittingBlock`): an element of the module that vanishes on `s` is zero.
-/

@[expose] public section

section RibetFirstOrder

namespace New.Selmer

open IsDiscreteValuationRing Matrix Module Submodule Polynomial MonoidAlgebra Finset Sum
  CompleteLattice

open Finsupp (linearCombination)

open MvPolynomial hiding X C aeval eval funext comap ext

/-! ### The set-up of Ribet's method to first order

The group algebra `Λ[G]`, `Λ = O[X j]`, acts through every representation and character over `O`
(`polyAction`, `polyChar`). -/

section SetUp

variable {O L Y G J σ : Type} [CommRing O] [CommRing L] [Algebra O L] [Fintype σ] [DecidableEq σ]
  [Group G] (u : Y → G →* Matrix σ σ O) {S : Subalgebra O (Y → MvPolynomial J L)}
  (𝒥 : Submodule S (Y → MvPolynomial J L))

/-- The action of `O[X j][G]` that extends a representation `ρ` of `G` over `O`. -/
noncomputable def polyAction (J : Type) {n : Type} [Fintype n] [DecidableEq n]
    (ρ : G →* Matrix n n O) :
    (MvPolynomial J O)[G] →ₐ[MvPolynomial J O] Matrix n n (MvPolynomial J O) :=
  lift (MvPolynomial J O) (Matrix n n (MvPolynomial J O)) G
    ((Algebra.ofId O (MvPolynomial J O)).mapMatrix.toMonoidHom.comp ρ)

/-- The element `c g` of `O[X j][G]` acts by `c` times the matrix `ρ g`. -/
lemma polyAction_single {n : Type} [Fintype n] [DecidableEq n] (ρ : G →* Matrix n n O) (g : G)
    (c : MvPolynomial J O) :
    polyAction J ρ (MonoidAlgebra.single g c) =
      c • (Algebra.ofId O (MvPolynomial J O)).mapMatrix (ρ g) := by
  simp [polyAction]

/-- The action of a polynomial in a group element `g` is that polynomial in the matrix `ρ g`. -/
lemma polyAction_aeval {n : Type} [Fintype n] [DecidableEq n] (ρ : G →* Matrix n n O) (g : G)
    (P : O[X]) :
    polyAction J ρ (aeval (MonoidAlgebra.single g (1 : MvPolynomial J O)) P) =
      (Algebra.ofId O (MvPolynomial J O)).mapMatrix (aeval (ρ g) P) := by
  have h_single : (polyAction J ρ).restrictScalars O (MonoidAlgebra.single g 1) =
      (Algebra.ofId O (MvPolynomial J O)).mapMatrix (ρ g) := by
    simp [polyAction_single]
  rw [← aeval_algHom_apply (Algebra.ofId O (MvPolynomial J O)).mapMatrix, ← h_single,
    aeval_algHom_apply, AlgHom.restrictScalars_apply]

/-- The action of `O[X j][G]` that extends a character `ξ` of `G` over `O`. -/
noncomputable def polyChar (J : Type) (ξ : G →* O) :
    (MvPolynomial J O)[G] →ₐ[MvPolynomial J O] MvPolynomial J O :=
  lift (MvPolynomial J O) (MvPolynomial J O) G
    ((Algebra.ofId O (MvPolynomial J O)).toMonoidHom.comp ξ)

/-- The element `c g` of `O[X j][G]` acts by `c * ξ g`. -/
lemma polyChar_single (ξ : G →* O) (g : G) (c : MvPolynomial J O) :
    polyChar J ξ (MonoidAlgebra.single g c) = c * .C (ξ g) := by
  simp [polyChar]

/-- Vectors over `O` as rows over `O[X j][G]`: the entries times the unit. -/
noncomputable def coordRows (J ι : Type) : (ι → O) →ₗ[O] ι → (MvPolynomial J O)[G] :=
  (LinearMap.toSpanSingleton O (MvPolynomial J O)[G]
    (MonoidAlgebra.of (MvPolynomial J O) G 1)).compLeft ι

/-- The action of `O[X j][G]` through `ρ` at `X j = 0`: an `O`-algebra map to matrices over `O`. -/
noncomputable def polyActionAtZero (J : Type) {n : Type} [Fintype n] [DecidableEq n]
    (ρ : G →* Matrix n n O) :
    (MvPolynomial J O)[G] →ₐ[O] Matrix n n O :=
  (MvPolynomial.aeval (0 : J → O)).mapMatrix.comp ((polyAction J ρ).restrictScalars O)

/-- A character reads the entry `j` of the row of `m` as the constant `m j`. -/
lemma polyChar_coordRows {ι : Type} (ξ : G →* O) (m : ι → O) (j : ι) :
    polyChar J ξ (coordRows J ι m j) = MvPolynomial.C (m j) := by
  have h : coordRows J ι m j = m j • (1 : (MvPolynomial J O)[G]) := rfl
  rw [h, AlgHom.map_smul_of_tower, map_one, MvPolynomial.C_eq_smul_one]

/-- At `X j = 0` the group element `g` acts as the matrix `ρ g`. -/
lemma polyActionAtZero_single {n : Type} [Fintype n] [DecidableEq n] (ρ : G →* Matrix n n O)
    (g : G) :
    polyActionAtZero J ρ (MonoidAlgebra.single g 1) = ρ g := by
  ext i j
  simp [polyActionAtZero, polyAction_single]

/-- At `X j = 0` every multiple of a variable `X j` acts as zero. -/
lemma polyActionAtZero_X_smul {n : Type} [Fintype n] [DecidableEq n] (ρ : G →* Matrix n n O)
    (j : J) (c : (MvPolynomial J O)[G]) :
    polyActionAtZero J ρ ((MvPolynomial.X j : MvPolynomial J O) • c) = 0 := by
  simp [polyActionAtZero, Matrix.map_smul']

/-- With all variables set to `0`, the entry `j` of the row of `m` acts as the scalar matrix
`m j`. -/
lemma polyActionAtZero_coordRows {n ι : Type} [Fintype n] [DecidableEq n] (ρ : G →* Matrix n n O)
    (m : ι → O) (j : ι) :
    polyActionAtZero J ρ (coordRows J ι m j) = m j • 1 := by
  have h : coordRows J ι m j = m j • (1 : (MvPolynomial J O)[G]) := rfl
  rw [h, map_smul, map_one]

/-- The row `r` as the element `∑ r i (gen i - 1)` of `O[X j][G]`. -/
noncomputable def rowValue (J : Type) {ι : Type} [Fintype ι] (gen : ι → G) :
    (ι → (MvPolynomial J O)[G]) →ₗ[(MvPolynomial J O)[G]] (MvPolynomial J O)[G] :=
  Fintype.linearCombination (MvPolynomial J O)[G] (MonoidAlgebra.of (MvPolynomial J O) G ∘ gen - 1)

/-- A row over `O[X j][G]` on `W' ⊕ ι'` read on the character `ξ`, with the coordinates in `W'`
(those of the `δ w`) forgotten. -/
noncomputable def evalRowAtChar (J : Type) (ξ : G →* O) (W' ι' : Type) :
    (W' ⊕ ι' → (MvPolynomial J O)[G]) →ₗ[MvPolynomial J O] ι' → MvPolynomial J O :=
  LinearMap.funLeft (MvPolynomial J O) (MvPolynomial J O) inr ∘ₗ
    (polyChar J ξ).toLinearMap.compLeft (W' ⊕ ι')

/-- The left ideal of `O[X j][G]` spanned by the elements `r` such that, for every `g`, the family
over `x` of the traces of `r g` under `u x` lies in `𝒥`. -/
noncomputable def traceLeftIdeal : Submodule (MvPolynomial J O)[G] (MvPolynomial J O)[G] :=
  span (MvPolynomial J O)[G] {r : (MvPolynomial J O)[G] | ∀ g : G,
    (fun x : Y ↦ MvPolynomial.map (algebraMap O L)
      (polyAction J (u x) r * polyAction J (u x) (MonoidAlgebra.single g 1)).trace) ∈ 𝒥}

/-- The augmentation ideal of `O[X j][G]`: the kernel of the trivial character. -/
noncomputable abbrev augmentationIdeal (J : Type) :
    Submodule (MvPolynomial J O)[G] (MvPolynomial J O)[G] :=
  RingHom.ker (polyChar J (1 : G →* O))

/-- The data defining the tie ideal in `O[X j][G]`: representations `u x` of `G` over `O`, a
modulus `p : O`, pairs of elements `τ k`, `φ k` (`k : J × Bool`), tie polynomials `ε j`, and a
normaliser element `ρ₀`. -/
structure TieSystem (O Y G J σ : Type) [CommRing O] [Fintype σ] [DecidableEq σ] [Group G] where
  u : Y → G →* Matrix σ σ O
  p : O
  τ : J × Bool → G
  φ : J × Bool → G
  ε : J → O[X]
  ρ₀ : (MvPolynomial J O)[G]

/-- The tie ideal of a `TieSystem`: the left ideal of `O[X j][G]` spanned by the elements that every
`T.u x` kills, by `T.p` times the augmentation ideal `I`, by the ties
`τ k - 1 - X j * (ε j)(φ k) * (φ k - 1)` for `k = (j, b)`, and by `I ρ₀`. -/
noncomputable def TieSystem.tieIdeal (T : TieSystem O Y G J σ) :
    Submodule (MvPolynomial J O)[G] (MvPolynomial J O)[G] :=
  (⨅ x : Y, RingHom.ker (polyAction J (T.u x))) ⊔
    (augmentationIdeal (O := O) (G := G) J).map (.mulRight (MvPolynomial J O)[G] (T.p • 1)) ⊔
    span (MvPolynomial J O)[G] (Set.range fun k : J × Bool ↦
      MonoidAlgebra.single (T.τ k) 1 - 1 - (MvPolynomial.X k.1 : MvPolynomial J O) •
        (aeval (MonoidAlgebra.of (MvPolynomial J O) G (T.φ k)) (T.ε k.1) *
          (MonoidAlgebra.single (T.φ k) 1 - 1))) ⊔
    (augmentationIdeal (O := O) (G := G) J).map (.mulRight (MvPolynomial J O)[G] T.ρ₀)

/-- The tied rows of a `TieSystem`: the rows `r` whose element `∑ r i (gen i - 1)` lies in the tie
ideal. -/
noncomputable def TieSystem.tiedRows {ι : Type} [Fintype ι] (T : TieSystem O Y G J σ)
    (gen : ι → G) : Submodule (MvPolynomial J O)[G] (ι → (MvPolynomial J O)[G]) :=
  comap (rowValue J gen) T.tieIdeal

/-- The row `c₁ z γ + (1 - e) z a` with `e = c₁ (γ - 1)`. If the `z g` are coordinates of the
`u · g - 1`, its element is `e + (1 - e) (a - 1)` up to elements that every `u x` kills. -/
noncomputable def normaliserRow {ι : Type} (z : G → ι → O) (γ a : G) (c₁ : O) :
    ι → (MvPolynomial J O)[G] :=
  c₁ • coordRows J ι (z γ) +
    (1 - c₁ • (MonoidAlgebra.single γ (1 : MvPolynomial J O) - 1)) • coordRows J ι (z a)

/-- The element `ρ₀ = e + (1 - e) (a - 1)` that Ribet's method uses, with `e = c₁ (γ - 1)`. -/
noncomputable def tiedNormaliser (J : Type) (γ a : G) (c₁ : O) : (MvPolynomial J O)[G] :=
  c₁ • (MonoidAlgebra.single γ (1 : MvPolynomial J O) - 1) +
    (1 - c₁ • (MonoidAlgebra.single γ (1 : MvPolynomial J O) - 1)) *
      (MonoidAlgebra.single a (1 : MvPolynomial J O) - 1)

/-- The trace of a matrix over `O`, read in `MvPolynomial J L`, is the trace of its image over
`O[X j]`. -/
lemma C_algebraMap_trace (A : Matrix σ σ O) :
    MvPolynomial.C (algebraMap O L A.trace) = MvPolynomial.map (algebraMap O L)
      ((Algebra.ofId O (MvPolynomial J O)).mapMatrix A).trace := by
  simp [trace]

/-- The generators in Ribet's method: the `δ w`, then the elements of `s₀`, then those of `s`. -/
abbrev ribetGenerators {W' : Type} (δ : W' → G) (s₀ s : Finset G) : W' ⊕ s₀ ⊕ s → G :=
  δ ⊕ᵥ ((↑) ⊕ᵥ (↑))

/-- The `z g` are coordinates of the `u · g - 1` in the `u · gen i - 1`: for all `g` and `x`,
`u x g - 1 = ∑ z g i (u x (gen i) - 1)`. -/
abbrev AreCoordinates {ι : Type} [Fintype ι] (gen : ι → G) (z : G → ι → O) : Prop :=
  ∀ g : G, Fintype.linearCombination O (fun (i : ι) (x : Y) ↦ u x (gen i) - 1) (z g) =
    fun x : Y ↦ u x g - 1

end SetUp

section TiedRows

variable {O Y G J σ : Type} [CommRing O] [Fintype σ] [DecidableEq σ] [Group G]
variable {ι : Type} [Fintype ι] {gen : ι → G} {z : G → ι → O}

/-- Under `u x`, the element `∑ m i (gen i - 1)` of the row of a vector `m` over `O` acts as the
combination of the matrices `u x (gen i) - 1` with coefficients `m i`. -/
lemma polyAction_rowValue_coordRows (u : Y → G →* Matrix σ σ O) (x : Y) (m : ι → O) :
    polyAction J (u x) (rowValue J gen (coordRows J ι m)) =
      (Algebra.ofId O (MvPolynomial J O)).mapMatrix
        (Fintype.linearCombination O (fun (i : ι) (y : Y) ↦ u y (gen i) - 1) m x) := by
  have h_row : rowValue J gen (coordRows J ι m) =
      ∑ i : ι, coordRows J ι m i * (MonoidAlgebra.single (gen i) 1 - 1) := rfl
  have h_coord (i : ι) : coordRows J ι m i = m i • (1 : (MvPolynomial J O)[G]) := rfl
  rw [h_row, Fintype.linearCombination_apply, Finset.sum_apply, map_sum, map_sum]
  refine sum_congr rfl fun i _ ↦ ?_
  simp only [h_coord, smul_one_mul, AlgHom.map_smul_of_tower, Pi.smul_apply, map_smul, map_sub,
    map_one, polyAction_single, one_smul]

/-- If the `z g` are coordinates of the `u · g - 1` in the `u · gen i - 1`, then the element of the
row of `z g` acts under `u x` as `g - 1`. -/
lemma polyAction_rowValue_coordRows_of_areCoordinates (u : Y → G →* Matrix σ σ O)
    (hz : AreCoordinates u gen z) (x : Y) (g : G) :
    polyAction J (u x) (rowValue J gen (coordRows J ι (z g))) =
      polyAction J (u x) (MonoidAlgebra.single g 1) - 1 := by
  simp only [polyAction_rowValue_coordRows, hz g, polyAction_single, one_smul, map_sub, map_one]

/-- The element `∑ w i (gen i - 1)` of every row `w` lies in the augmentation ideal. -/
lemma rowValue_mem_augmentationIdeal (w : ι → (MvPolynomial J O)[G]) :
    rowValue J gen w ∈ augmentationIdeal (O := O) (G := G) J := by
  simp [RingHom.mem_ker, rowValue, Fintype.linearCombination_apply, polyChar_single]

variable (T : TieSystem O Y G J σ)

/-- A row whose element `∑ r i (gen i - 1)` is killed by every `T.u x` is tied. -/
lemma TieSystem.mem_tiedRows_of_forall_eq_zero {r : ι → (MvPolynomial J O)[G]}
    (h_zero : ∀ x : Y, polyAction J (T.u x) (rowValue J gen r) = 0) :
    r ∈ T.tiedRows gen :=
  mem_sup_left (mem_sup_left (mem_sup_left
    ((Submodule.mem_iInf _).2 fun x ↦ RingHom.mem_ker.2 (h_zero x))))

/-- The cocycle rule: the row of `z (g h) - z g` minus `g` times the row of `z h` is tied, as
every `T.u x` kills its element. -/
lemma TieSystem.coordRows_cocycle_mem_tiedRows (hz : AreCoordinates T.u gen z) (g h : G) :
    coordRows J ι (z (g * h) - z g) -
      MonoidAlgebra.single g (1 : MvPolynomial J O) • coordRows J ι (z h) ∈
      T.tiedRows gen := by
  refine T.mem_tiedRows_of_forall_eq_zero fun x ↦ ?_
  have h_mul : polyAction J (T.u x) (MonoidAlgebra.single (g * h) 1) =
      polyAction J (T.u x) (MonoidAlgebra.single g 1) *
        polyAction J (T.u x) (MonoidAlgebra.single h 1) := by
    rw [← map_mul, MonoidAlgebra.single_mul_single, one_mul]
  simp [polyAction_rowValue_coordRows_of_areCoordinates T.u hz, h_mul, mul_sub]

/-- If the `z g` are coordinates of the `T.u · g - 1`, then `coordRows J ι (z (gen i))` minus the
unit vector `i` is tied. -/
lemma TieSystem.coordRows_gen_sub_single_mem_tiedRows [DecidableEq ι]
    (hz : AreCoordinates T.u gen z) (i : ι) :
    coordRows J ι (z (gen i)) - Pi.single i 1 ∈ T.tiedRows gen := by
  refine T.mem_tiedRows_of_forall_eq_zero fun x ↦ ?_
  have h_unit : rowValue (O := O) J gen (Pi.single i 1) = MonoidAlgebra.single (gen i) 1 - 1 := by
    simp [rowValue]
  simp [polyAction_rowValue_coordRows_of_areCoordinates T.u hz, h_unit]

/-- If the `z g` are coordinates of the `T.u · g - 1` and `∑ θ g (T.u · g - 1) = 0`, then the row
of `∑ θ g z g` is tied. -/
lemma TieSystem.coordRows_linearCombination_mem_tiedRows (hz : AreCoordinates T.u gen z)
    (θ : G →₀ O) (hθ : linearCombination O (fun (g : G) (x : Y) ↦ T.u x g - 1) θ = 0) :
    coordRows J ι (linearCombination O z θ) ∈ T.tiedRows gen := by
  refine T.mem_tiedRows_of_forall_eq_zero fun x ↦ ?_
  have h_comb : Fintype.linearCombination O (fun (i : ι) (y : Y) ↦ T.u y (gen i) - 1)
      (linearCombination O z θ) = linearCombination O (fun (g : G) (y : Y) ↦ T.u y g - 1) θ := by
    simp only [Finsupp.apply_linearCombination, Function.comp_def, hz]
  rw [polyAction_rowValue_coordRows, h_comb, hθ, Pi.zero_apply, map_zero]

/-- `T.p` times a row is tied: its element lies in `T.p` times the augmentation ideal. -/
lemma TieSystem.smul_mem_tiedRows (w : ι → (MvPolynomial J O)[G]) : T.p • w ∈ T.tiedRows gen := by
  have h_smul : rowValue J gen (T.p • w) = rowValue J gen w * (T.p • 1) := by
    rw [LinearMap.map_smul_of_tower, mul_smul_one]
  exact mem_comap.2 (h_smul ▸ mem_sup_left (mem_sup_left (mem_sup_right
    (mem_map_of_mem (rowValue_mem_augmentationIdeal w)))))

end TiedRows

section TiedRelations

variable {O L Y G J σ : Type} [CommRing O] [CommRing L] [Algebra O L] [Fintype σ] [DecidableEq σ]
  [Group G] (T : TieSystem O Y G J σ) {S : Subalgebra O (Y → MvPolynomial J L)}
  (𝒥 : Submodule S (Y → MvPolynomial J L))

/-- The ties: the row of `z (T.τ i)` minus `X i.1 * (T.ε i.1)(T.φ i)` times the row of `z (T.φ i)`
is tied. -/
lemma TieSystem.coordRows_tau_sub_mem_tiedRows {ι : Type} [Fintype ι] {gen : ι → G}
    {z : G → ι → O} (hz : AreCoordinates T.u gen z) (i : J × Bool) :
    coordRows J ι (z (T.τ i)) - (MvPolynomial.X i.1 : MvPolynomial J O) •
      aeval (MonoidAlgebra.of (MvPolynomial J O) G (T.φ i)) (T.ε i.1) •
        coordRows J ι (z (T.φ i)) ∈ T.tiedRows gen := by
  have h_ker (g : G) : rowValue J gen (coordRows J ι (z g)) - (MonoidAlgebra.single g 1 - 1) ∈
      ⨅ x : Y, RingHom.ker (polyAction J (T.u x)) := by
    simp [RingHom.mem_ker, polyAction_rowValue_coordRows_of_areCoordinates T.u hz]
  set c : (MvPolynomial J O)[G] := aeval (MonoidAlgebra.of (MvPolynomial J O) G (T.φ i)) (T.ε i.1)
  have h_val : rowValue J gen (coordRows J ι (z (T.τ i)) -
      (MvPolynomial.X i.1 : MvPolynomial J O) • c • coordRows J ι (z (T.φ i))) =
      (MonoidAlgebra.single (T.τ i) 1 - 1 -
        (MvPolynomial.X i.1 : MvPolynomial J O) • (c * (MonoidAlgebra.single (T.φ i) 1 - 1))) +
      ((rowValue J gen (coordRows J ι (z (T.τ i))) - (MonoidAlgebra.single (T.τ i) 1 - 1)) -
        (MvPolynomial.X i.1 : MvPolynomial J O) • (c *
          (rowValue J gen (coordRows J ι (z (T.φ i))) -
            (MonoidAlgebra.single (T.φ i) 1 - 1)))) := by
    simp only [map_sub, LinearMap.map_smul_of_tower, map_smul, smul_eq_mul, mul_sub, smul_sub]
    abel
  refine mem_comap.2 (h_val ▸ add_mem (mem_sup_left (mem_sup_right (subset_span ⟨i, rfl⟩)))
    (mem_sup_left (mem_sup_left (mem_sup_left ?_))))
  exact sub_mem (h_ker (T.τ i))
    (Submodule.smul_of_tower_mem _ _ (Ideal.mul_mem_left _ c (h_ker (T.φ i))))

/-- The multiples of `ρ₀`: if `T.ρ₀ = tiedNormaliser J γ a c₁`, then `(g - 1) • normaliserRow` is
tied. -/
lemma TieSystem.sub_one_smul_normaliserRow_mem_tiedRows {ι : Type} [Fintype ι] {gen : ι → G}
    {z : G → ι → O} (hz : AreCoordinates T.u gen z) {γ a : G} {c₁ : O}
    (hρ₀ : T.ρ₀ = tiedNormaliser J γ a c₁) (g : G) :
    (MonoidAlgebra.single g (1 : MvPolynomial J O) - 1) • normaliserRow z γ a c₁ ∈
      T.tiedRows gen := by
  set g₁ : (MvPolynomial J O)[G] := MonoidAlgebra.single g 1 - 1 with hg₁
  have h_diff : rowValue J gen (g₁ • normaliserRow z γ a c₁) = g₁ * T.ρ₀ +
      g₁ * (rowValue J gen (normaliserRow z γ a c₁) - T.ρ₀) := by
    rw [map_smul, smul_eq_mul, mul_sub, add_sub_cancel]
  have h_aug : g₁ ∈ augmentationIdeal (O := O) (G := G) J := by
    simp [hg₁, RingHom.mem_ker, polyChar_single]
  have h_ker : rowValue J gen (normaliserRow z γ a c₁) - T.ρ₀ ∈
      ⨅ x : Y, RingHom.ker (polyAction J (T.u x)) := by
    simp [hρ₀, RingHom.mem_ker, normaliserRow, tiedNormaliser,
      polyAction_rowValue_coordRows_of_areCoordinates T.u hz, AlgHom.map_smul_of_tower]
  refine mem_comap.2 (h_diff ▸ add_mem (mem_sup_right (mem_map_of_mem h_aug))
    (mem_sup_left (mem_sup_left (mem_sup_left (Ideal.mul_mem_left _ g₁ h_ker)))))

/-- If the generators with index in `W'` are the `δ w` and `o w * (X - 1)` kills every
`T.u x (δ w)`, then the row with entry `o w (δ w)` at `inl w` is tied. -/
lemma TieSystem.single_mem_tiedRows {W' κ' : Type} [Fintype W'] [DecidableEq W'] [Fintype κ']
    [DecidableEq κ'] {gen : W' ⊕ κ' → G} {δ : W' → G} (h_gen : ∀ w : W', gen (inl w) = δ w)
    {o : W' → O[X]} (hδ_poly : ∀ (w : W') (x : Y), aeval (T.u x (δ w)) (o w * (X - 1)) = 0)
    (w : W') :
    Pi.single (inl w) (aeval (MonoidAlgebra.of (MvPolynomial J O) G (δ w)) (o w)) ∈
      T.tiedRows gen := by
  refine T.mem_tiedRows_of_forall_eq_zero fun x ↦ ?_
  have h_val : rowValue J gen
      (Pi.single (inl w) (aeval (MonoidAlgebra.of (MvPolynomial J O) G (δ w)) (o w))) =
      aeval (MonoidAlgebra.single (δ w) (1 : MvPolynomial J O)) (o w * (X - 1)) := by
    simp [rowValue, h_gen]
  rw [h_val, polyAction_aeval, hδ_poly, map_zero]

/-- If `𝒥` is a trace ideal for `T`, then `T.tieIdeal` lies in the sum of `traceLeftIdeal T.u 𝒥`
and `I T.ρ₀`. -/
lemma TieSystem.tieIdeal_le (h𝒥 : IsTraceIdeal 𝒥 (fun x : Y ↦ T.u x) T.p T.τ T.φ Prod.fst T.ε) :
    T.tieIdeal ≤ traceLeftIdeal T.u 𝒥 ⊔
      (augmentationIdeal (O := O) (G := G) J).map (.mulRight (MvPolynomial J O)[G] T.ρ₀) := by
  rw [TieSystem.tieIdeal]
  refine sup_le_sup_right (sup_le (sup_le ?_ ?_) ?_) _
  · refine fun r hr ↦ subset_span fun g ↦ ?_
    have h_zero (x : Y) : polyAction J (T.u x) r = 0 :=
      RingHom.mem_ker.1 ((Submodule.mem_iInf _).1 hr x)
    simp [h_zero, ← Pi.zero_def]
  · rintro _ ⟨r, -, rfl⟩
    refine Ideal.mul_mem_left _ r (subset_span fun g ↦ ?_)
    have h_act (x : Y) :
        polyAction J (T.u x) (T.p • 1) * polyAction J (T.u x) (MonoidAlgebra.single g 1) =
          (Algebra.ofId O (MvPolynomial J O)).mapMatrix (T.p • T.u x g) := by
      rw [AlgHom.map_smul_of_tower, map_one, smul_one_mul, polyAction_single, one_smul, map_smul]
    simpa only [h_act, ← C_algebraMap_trace, trace_smul] using h𝒥.smul_trace_mem g
  · refine span_le.2 (Set.range_subset_iff.2 fun k ↦ subset_span fun g ↦ ?_)
    have h_τ (x : Y) : polyAction J (T.u x) (MonoidAlgebra.single (T.τ k) 1 - 1) =
        (Algebra.ofId O (MvPolynomial J O)).mapMatrix (T.u x (T.τ k) - 1) := by
      rw [map_sub, map_sub, map_one, map_one, polyAction_single, one_smul]
    have h_φ (x : Y) :
        polyAction J (T.u x) (aeval (MonoidAlgebra.of (MvPolynomial J O) G (T.φ k)) (T.ε k.1) *
          (MonoidAlgebra.single (T.φ k) 1 - 1)) =
        (Algebra.ofId O (MvPolynomial J O)).mapMatrix
          (aeval (T.u x (T.φ k)) ((X - 1) * T.ε k.1)) := by
      rw [← polyAction_aeval, mul_comm (X - 1 : O[X])]
      simp
    have h_act (x : Y) : polyAction J (T.u x) (MonoidAlgebra.single (T.τ k) 1 - 1 -
        (MvPolynomial.X k.1 : MvPolynomial J O) •
          (aeval (MonoidAlgebra.of (MvPolynomial J O) G (T.φ k)) (T.ε k.1) *
            (MonoidAlgebra.single (T.φ k) 1 - 1))) *
          polyAction J (T.u x) (MonoidAlgebra.single g 1) =
        (Algebra.ofId O (MvPolynomial J O)).mapMatrix ((T.u x (T.τ k) - 1) * T.u x g) -
          (MvPolynomial.X k.1 : MvPolynomial J O) • (Algebra.ofId O (MvPolynomial J O)).mapMatrix
            (aeval (T.u x (T.φ k)) ((X - 1) * T.ε k.1) * T.u x g) := by
      rw [map_sub, map_smul, h_τ, h_φ, polyAction_single, one_smul, sub_mul, smul_mul_assoc,
        ← map_mul, ← map_mul]
    simp only [h_act]
    simpa only [trace_sub, trace_smul, map_sub, smul_eq_mul, map_mul, MvPolynomial.map_X,
      C_algebraMap_trace] using h𝒥.trace_relation_mem g k

end TiedRelations

section Steps

variable {O Y G J σ W : Type} [CommRing O] [Fintype σ] [DecidableEq σ] [Group G]
  (T : TieSystem O Y G J σ)

/-! ### The matrix on the main summand -/

/-- Let the matrices `ρ g` span, and let `γ` act through `ρ` as the scalar `y` with
`c₁ (y - 1) = 1`. Let `b₀` bound the length of the module of cocycles of `ρ` with values in `K/O`
that obey the linear relations among the `(T.u x g - 1)_x` and vanish at the `T.τ k` and at `γ`.
Then some square matrix of tied rows has, through `ρ` at `X j = 0`, a determinant of valuation at
most `b₀`. -/
lemma TieSystem.exists_tiedRows_addVal_det_le [DVR O] {r ι : Type} [Fintype r]
    [DecidableEq r] [Fintype ι] [DecidableEq ι] (ρ : G →* Matrix r r O)
    (hρ_span : span O (Set.range ρ) = ⊤) {γ a : G} {y c₁ : O} (hργ : ρ γ = y • 1)
    (hc₁ : c₁ * (y - 1) = 1) (hρ₀ : T.ρ₀ = tiedNormaliser J γ a c₁) {gen : ι → G} {z : G → ι → O}
    (hz : AreCoordinates T.u gen z) {b₀ : ℕ}
    (hb₀ : length O (ribetCocyclesVanishingOn T.u ρ (DivisibleQuot O) (Set.range T.τ) γ) ≤ b₀) :
    ∃ B₀ : Matrix ι ι (MvPolynomial J O)[G],
      (∀ i : ι, B₀ i ∈ T.tiedRows gen) ∧
      addVal O (Matrix.comp ι ι r r O (B₀.map (polyActionAtZero J ρ))).det ≤ b₀ := by
  have h_τ (k : J × Bool) : ∃ t ∈ T.tiedRows gen, ∀ j : ι,
      polyActionAtZero J ρ (t j) = polyActionAtZero J ρ (coordRows J ι (z (T.τ k)) j) := by
    refine ⟨coordRows J ι (z (T.τ k)) - (MvPolynomial.X k.1 : MvPolynomial J O) •
        aeval (MonoidAlgebra.of (MvPolynomial J O) G (T.φ k)) (T.ε k.1) •
          coordRows J ι (z (T.φ k)),
      T.coordRows_tau_sub_mem_tiedRows hz k, fun j ↦ ?_⟩
    rw [Pi.sub_apply, map_sub, Pi.smul_apply, polyActionAtZero_X_smul, sub_zero]
  have h_γ : ∃ t ∈ T.tiedRows gen, ∀ j : ι,
      polyActionAtZero J ρ (t j) = polyActionAtZero J ρ (coordRows J ι (z γ) j) := by
    have h_one (A : Matrix r r O) : c₁ • (y • A - A) = A :=
      calc c₁ • (y • A - A) = (c₁ * (y - 1)) • A := by rw [mul_smul, sub_smul, one_smul]
        _ = A := by rw [hc₁, one_smul]
    refine ⟨(MonoidAlgebra.single γ (1 : MvPolynomial J O) - 1) • normaliserRow z γ a c₁,
      T.sub_one_smul_normaliserRow_mem_tiedRows hz hρ₀ γ, fun j ↦ ?_⟩
    simp [normaliserRow, polyActionAtZero_single, hργ, h_one, mul_add, sub_mul, map_smul]
  exact exists_block_rows T.u ρ hρ_span (polyActionAtZero J ρ)
    (MonoidAlgebra.of (MvPolynomial J O) G) (polyActionAtZero_single ρ) (coordRows J ι)
    (polyActionAtZero_coordRows ρ) gen z (T.tiedRows gen) T.τ γ hb₀
    (T.coordRows_cocycle_mem_tiedRows hz) (T.coordRows_gen_sub_single_mem_tiedRows hz)
    (T.coordRows_linearCombination_mem_tiedRows hz) h_τ h_γ

/-! ### The matrix on the characters -/

/-- Read tied rows on a character `ξ` (trivial at `γ`) with the `δ`-coordinates forgotten, apply
`A`, and let `K` contain the image. Then every `c ∈ formsMod _ z K T.p` is a character cocycle for
`ξ`. -/
lemma TieSystem.isCharacterCocycle_of_tiedRows {ξ : G →* O} [Fintype W] {δ : W → G}
    {ι' r' : Type} [Fintype ι'] {gen' : ι' → G} {z : G → W ⊕ ι' → O}
    (hz : AreCoordinates T.u (δ ⊕ᵥ gen') z) {γ a : G} {c₁ : O} (hξγ : ξ γ = 1)
    (hρ₀ : T.ρ₀ = tiedNormaliser J γ a c₁)
    (A : (ι' → MvPolynomial J O) →ₗ[MvPolynomial J O] r' → MvPolynomial J O)
    {K : Submodule (MvPolynomial J O) (r' → MvPolynomial J O)}
    (hK : ((T.tiedRows (δ ⊕ᵥ gen')).restrictScalars (MvPolynomial J O)).map
      (A ∘ₗ evalRowAtChar J ξ W ι') ≤ K) :
    ∀ c ∈ formsMod ((A ∘ₗ evalRowAtChar J ξ W ι').restrictScalars O ∘ₗ coordRows J (W ⊕ ι'))
      z K T.p, IsCharacterCocycle T.u ξ δ γ a c := by
  classical
  set Φ : (W ⊕ ι' → O) →ₗ[O] r' → MvPolynomial J O :=
    (A ∘ₗ evalRowAtChar J ξ W ι').restrictScalars O ∘ₗ coordRows J (W ⊕ ι')
  have h_row (m : W ⊕ ι' → O) {w : W ⊕ ι' → (MvPolynomial J O)[G]} (hw : w ∈ T.tiedRows (δ ⊕ᵥ gen'))
      (h_read : ∀ i : ι', polyChar J ξ (w (inr i)) = MvPolynomial.C (m (inr i))) : Φ m ∈ K := by
    have h_eq : evalRowAtChar J ξ W ι' w = evalRowAtChar J ξ W ι' (coordRows J (W ⊕ ι') m) :=
      funext fun i ↦ (h_read i).trans (polyChar_coordRows ξ m (inr i)).symm
    exact hK ⟨w, hw, congrArg A h_eq⟩
  refine isCharacterCocycle_of_mem_formsMod T.u Φ z K ξ δ a γ c₁ ?_ ?_ ?_ ?_
  · exact fun g h ↦ h_row _ (T.coordRows_cocycle_mem_tiedRows hz g h) fun i ↦ by
      simp [polyChar_coordRows, polyChar_single]
  · exact fun w ↦ h_row _ (T.coordRows_gen_sub_single_mem_tiedRows hz (inl w)) fun i ↦ by
      simp [polyChar_coordRows]
  · exact fun θ hθ ↦ h_row _ (T.coordRows_linearCombination_mem_tiedRows hz θ hθ) fun i ↦
      polyChar_coordRows ξ _ (inr i)
  · exact fun g ↦ h_row _ (T.sub_one_smul_normaliserRow_mem_tiedRows hz hρ₀ g) fun i ↦ by
      simp [normaliserRow, polyChar_coordRows, polyChar_single, hξγ, AlgHom.map_smul_of_tower,
        MvPolynomial.smul_eq_C_mul]

/-- The ties hold on a character `ξ` when `T.ε k.1` is `1` modulo `T.p` at `ξ (T.φ k)`. -/
lemma TieSystem.tie_mem_map_tiedRows (ξ : G →* O) [Fintype W] {δ : W → G} {ι' r' : Type}
    [Fintype ι'] {gen' : ι' → G} {z : G → W ⊕ ι' → O} (hz : AreCoordinates T.u (δ ⊕ᵥ gen') z)
    (A : (ι' → MvPolynomial J O) →ₗ[MvPolynomial J O] r' → MvPolynomial J O) (k : J × Bool)
    (hε : T.p ∣ (T.ε k.1).eval (ξ (T.φ k)) - 1) :
    A (fun l : ι' ↦ polyChar J ξ (coordRows J (W ⊕ ι') (z (T.τ k)) (inr l))) -
        (MvPolynomial.X k.1 : MvPolynomial J O) •
          A (fun l : ι' ↦ polyChar J ξ (coordRows J (W ⊕ ι') (z (T.φ k)) (inr l))) ∈
      ((T.tiedRows (δ ⊕ᵥ gen')).restrictScalars (MvPolynomial J O)).map
        (A ∘ₗ evalRowAtChar J ξ W ι') := by
  obtain ⟨c, hc⟩ : ∃ c : O, (T.ε k.1).eval (ξ (T.φ k)) - 1 = T.p * c := hε
  have h_ε : polyChar J ξ
      (aeval (MonoidAlgebra.single (T.φ k) (1 : MvPolynomial J O)) (T.ε k.1)) =
      1 + .C T.p * .C c := by
    rw [← map_mul, ← hc, map_sub, map_one, add_sub_cancel]
    simp [polyChar_single, aeval_eq_sum_range, eval_eq_sum_range, MvPolynomial.smul_eq_C_mul]
  refine ⟨_, add_mem (T.coordRows_tau_sub_mem_tiedRows hz k) (T.smul_mem_tiedRows
    ((.X k.1 : MvPolynomial J O) • coordRows J (W ⊕ ι') (c • z (T.φ k)))), ?_⟩
  rw [← A.map_smul, ← A.map_sub, LinearMap.comp_apply]
  refine congrArg A (funext fun l ↦ ?_)
  have h_ring (x y₁ y₂ p' c' : MvPolynomial J O) :
      y₁ - x * ((1 + p' * c') * y₂) + p' * (x * (c' * y₂)) = y₁ - x * y₂ := by ring
  simp [h_ε, h_ring, coordRows, polyChar_single, evalRowAtChar, MvPolynomial.smul_eq_C_mul]

/-- The Fitting block of one character `ξ` of type `e : Fin t`. -/
lemma TieSystem.exists_mem_fittingIdeal_character [DVR O] [Fintype J] [LinearOrder J]
    [DecidableEq G] {t : ℕ} (ξ : G →* O) [Fintype W] [DecidableEq W] {δ : W → G} {s₀ s : Finset G}
    {z : G → W ⊕ s₀ ⊕ s → O} (hz : AreCoordinates T.u (ribetGenerators δ s₀ s) z)
    {γ a : G} {c₁ C : O} (hξγ : ξ γ = 1) (hρ₀ : T.ρ₀ = tiedNormaliser J γ a c₁) (hp : T.p ≠ 0)
    (ty : J →o Fin t) {be : ℕ∞} (e : Fin t)
    (hε : ∀ k : J × Bool, T.p ∣ (T.ε k.1).eval (ξ (T.φ k)) - 1)
    (h_cost : ∀ Z : Submodule O (G → Unit → QuotSpan T.p),
      (∀ c ∈ Z, IsCharacterCocycle T.u ξ δ γ a c) →
      HasTriangleCost Z (fun j : J ↦ T.τ (j, true)) (fun j : J ↦ T.τ (j, false))
        (fun j : J ↦ T.φ (j, true)) (fun j : J ↦ T.φ (j, false)) {j : J | ty j = e} C be)
    (ν : s₀ → W ⊕ s₀ ⊕ s → (MvPolynomial J O)[G]) :
    ∃ Γ : MvPolynomial J O,
      addVal O (constantCoeff Γ) ≤ be + (#{j : J | ty j = e} + #s) * addVal O C ∧
      Γ * ∏ j : J with ty j = e, MvPolynomial.X j ∈ fittingIdeal
        (((T.tiedRows (ribetGenerators δ s₀ s)).restrictScalars (MvPolynomial J O)).map
          (vecMulLinear
            (fromRows (-of fun (i : s₀) (j : s) ↦ polyChar J ξ (ν i (inr (inr j))))
              (1 : Matrix s s (MvPolynomial J O))) ∘ₗ evalRowAtChar J ξ W (s₀ ⊕ s)) ⊔
        (nonDivisorIdeal O J).colon {∏ j : J with ty j < e, MvPolynomial.X j} • ⊤) := by
  let Λ : Type := MvPolynomial J O
  let η : Λ[G] →ₐ[Λ] Λ := polyChar J ξ
  let v : (W ⊕ s₀ ⊕ s → O) →ₗ[O] W ⊕ s₀ ⊕ s → Λ[G] := coordRows J (W ⊕ s₀ ⊕ s)
  let A : (s₀ ⊕ s → Λ) →ₗ[Λ] s → Λ :=
    vecMulLinear (fromRows (-of fun i j ↦ η (ν i (inr (inr j)))) (1 : Matrix s s Λ))
  let F : (W ⊕ s₀ ⊕ s → Λ[G]) →ₗ[Λ] s → Λ := A ∘ₗ evalRowAtChar J ξ W (s₀ ⊕ s)
  let K : Submodule Λ (s → Λ) :=
    ((T.tiedRows (ribetGenerators δ s₀ s)).restrictScalars Λ).map F ⊔
      (nonDivisorIdeal O J).colon {∏ j with ty j < e, MvPolynomial.X j} • ⊤
  let Φ : (W ⊕ s₀ ⊕ s → O) →ₗ[O] s → Λ := F.restrictScalars O ∘ₗ v
  have h_cocycle : ∀ c ∈ formsMod Φ z K T.p, IsCharacterCocycle T.u ξ δ γ a c :=
    T.isCharacterCocycle_of_tiedRows hz hξγ hρ₀ A le_sup_left
  have h_smul (w : W ⊕ s₀ ⊕ s → O) : Φ (T.p • w) ∈ K :=
    mem_sup_left ⟨T.p • v w, T.smul_mem_tiedRows (v w), by simp [Φ]⟩
  have h_gen (g : s) : Φ (z g) - Pi.single g (1 : Λ) ∈ K := by
    have h_unit : F (Pi.single (inr (inr g)) 1) = Pi.single g 1 := by
      ext1
      simp [Λ, F, A, evalRowAtChar, vecMul_eq_sum, Pi.single_apply, Matrix.one_apply, ite_apply,
        eq_comm]
    have h_row : Φ (z g) - Pi.single g 1 = F (v (z g) - Pi.single (inr (inr g)) 1) := by
      simp [Φ, h_unit]
    rw [h_row]
    exact mem_sup_left (mem_map_of_mem (T.coordRows_gen_sub_single_mem_tiedRows hz (inr (inr g))))
  have h_tie (k : J × Bool) : Φ (z (T.τ k)) - (MvPolynomial.X k.1 : Λ) • Φ (z (T.φ k)) ∈ K :=
    mem_sup_left (T.tie_mem_map_tiedRows ξ hz A k (hε k))
  refine exists_mul_prod_X_mem_fittingIdeal hp (h_cost _ h_cocycle) h_smul h_gen
    (fun j ↦ h_tie (j, true)) (fun j ↦ h_tie (j, false)) fun j hj i hij ↦ ?_
  have hj_type : ty j = e := by simpa using hj
  obtain h_eq | h_lt : ty i = e ∨ ty i < e := ((ty.mono hij.le).trans_eq hj_type).eq_or_lt
  · exact .inl (by simp [h_eq])
  · exact .inr fun w ↦ mem_sup_right (smul_mem_smul (X_mem_colon_nonDivisorIdeal h_lt) mem_top)

/-- Complete the rows `L k` (`k : κ`) to a square matrix by, for each `w : W`, the row with entry
`o w (δ w)` at `inl w` and `0` elsewhere. If `ξ` is `1` at every `δ w`, then its determinant on `ξ`
is `∏ o w (1)` times the determinant of `L k (inr k')` on `ξ`. -/
lemma det_map_polyChar_tame_rows {κ : Type} [Fintype κ] [DecidableEq κ] [Fintype W] [DecidableEq W]
    {ξ : G →* O} {δ : W → G} (hξδ : ∀ w : W, ξ (δ w) = 1) (o : W → O[X])
    (L : κ → W ⊕ κ → (MvPolynomial J O)[G]) :
    ((of (Sum.elim (fun w : W ↦
        Pi.single (inl w) (aeval (MonoidAlgebra.of (MvPolynomial J O) G (δ w)) (o w))) L)).map
          (polyChar J ξ)).det =
      .C (∏ w : W, (o w).eval 1) *
        ((of fun k k' : κ ↦ L k (inr k')).map (polyChar J ξ)).det := by
  set P : Matrix (W ⊕ κ) (W ⊕ κ) (MvPolynomial J O) := (of (Sum.elim (fun w : W ↦
    Pi.single (inl w) (aeval (MonoidAlgebra.of (MvPolynomial J O) G (δ w)) (o w))) L)).map
      (polyChar J ξ) with hP
  have h_blocks : P = fromBlocks (diagonal fun w ↦ .C ((o w).eval 1)) 0 P.toBlocks₂₁
      ((of fun k k' : κ ↦ L k (inr k')).map (polyChar J ξ)) := by
    ext1 (w | k) (w' | k')
    · simp [hP, polyChar_single, hξδ, diagonal_apply, Pi.single_apply, eq_comm,
        apply_ite (polyChar J ξ), aeval_eq_sum_range, MvPolynomial.smul_eq_C_mul,
        eval_eq_sum_range]
    · simp [hP]
    · rfl
    · rfl
  rw [h_blocks, det_fromBlocks_zero₁₂, det_diagonal, map_prod]

/-- There are tied rows `ν i` whose `s₀`-part is the unit vector `i` on every character `ξ e`. -/
lemma TieSystem.exists_unit_rows_mem_tiedRows [DVR O] [DecidableEq G] {t : ℕ} {ξ : Fin t → G →* O}
    [Fintype W] [DecidableEq W] {δ : W → G} {s₀ s : Finset G} {z : G → W ⊕ s₀ ⊕ s → O}
    (hz : AreCoordinates T.u (ribetGenerators δ s₀ s) z) {γ a : G} {c₁ : O}
    (hξγ : ∀ e : Fin t, ξ e γ = 1) (hρ₀ : T.ρ₀ = tiedNormaliser J γ a c₁) (hp : T.p ≠ 0)
    (h_detect : ∀ (e : Fin t) (Z : Submodule O (G → Unit → QuotSpan T.p)),
      (∀ c ∈ Z, IsCharacterCocycle T.u (ξ e) δ γ a c) → IsDetectedBy Z s) :
    ∃ ν : s₀ → W ⊕ s₀ ⊕ s → (MvPolynomial J O)[G],
      (∀ i : s₀, ν i ∈ T.tiedRows (ribetGenerators δ s₀ s)) ∧
      ∀ (e : Fin t) (i j : s₀), polyChar J (ξ e) (ν i (inr (inl j))) = if j = i then 1 else 0 := by
  let N : Submodule (MvPolynomial J O)[G] (W ⊕ s₀ ⊕ s → (MvPolynomial J O)[G]) :=
    T.tiedRows (ribetGenerators δ s₀ s)
  have h_one (e : Fin t) (i : s₀) :
      ∃ w ∈ N, ∀ j : s₀, polyChar J (ξ e) (w (inr (inl j))) = if j = i then 1 else 0 := by
    let F : (W ⊕ s₀ ⊕ s → (MvPolynomial J O)[G]) →ₗ[MvPolynomial J O] s₀ → MvPolynomial J O :=
      LinearMap.funLeft _ _ inl ∘ₗ evalRowAtChar J (ξ e) W (s₀ ⊕ s)
    let Z : Submodule O (G → Unit → QuotSpan T.p) :=
      formsMod (F.restrictScalars O ∘ₗ coordRows J (W ⊕ s₀ ⊕ s)) z
        ((N.restrictScalars (MvPolynomial J O)).map F) T.p
    have hZ : ∀ c ∈ Z, IsCharacterCocycle T.u (ξ e) δ γ a c :=
      T.isCharacterCocycle_of_tiedRows hz (hξγ e) hρ₀ (LinearMap.funLeft _ _ inl) le_rfl
    exact exists_unit_row (polyChar J (ξ e)) N (coordRows J (W ⊕ s₀ ⊕ s)) (ribetGenerators δ s₀ s) z
      hp T.smul_mem_tiedRows (T.coordRows_gen_sub_single_mem_tiedRows hz) (fun _ ↦ rfl) F
      (fun _ _ ↦ rfl) (h_detect e Z hZ) i
  have h_all (i : s₀) : ∃ w ∈ N, ∀ (e : Fin t) (j : s₀),
      polyChar J (ξ e) (w (inr (inl j))) = if j = i then 1 else 0 :=
    exists_common_unit_row (fun e ↦ polyChar J (ξ e)) N (fun j : s₀ ↦ inr (inl j)) h_one i
  choose ν hν hν_eq using h_all
  exact ⟨ν, hν, fun e i j ↦ hν_eq i e j⟩

/-- Matrices of tied rows serving all characters `ξ e` at once. Under the triangle-cost and
detection hypotheses on character cocycles, there are weights `wt k` and matrices `M k` of tied rows
together with a multiplier `Q` of bounded constant-term valuation such that, for any `F`,
`F * ∑ k, wt k * ∏ e, det (M k on ξ e)` has no monomial properly dividing `∏ X j` and has
coefficient `constantCoeff (F * Q)` at `∏ X j`. -/
lemma TieSystem.exists_characterRows [DVR O] [Fintype J] [LinearOrder J] [DecidableEq G] {t : ℕ}
    {ξ : Fin t → G →* O} [Fintype W] [DecidableEq W] {δ : W → G} {o : W → O[X]}
    (hξδ : ∀ (v : W) (e : Fin t), ξ e (δ v) = 1)
    (hδ_poly : ∀ (v : W) (x : Y), aeval (T.u x (δ v)) (o v * (X - 1)) = 0) {s₀ s : Finset G}
    {z : G → W ⊕ s₀ ⊕ s → O} (hz : AreCoordinates T.u (ribetGenerators δ s₀ s) z)
    {γ a : G} {c₁ C : O} (hξγ : ∀ e : Fin t, ξ e γ = 1) (hρ₀ : T.ρ₀ = tiedNormaliser J γ a c₁)
    (hp : T.p ≠ 0) (hε : ∀ (e : Fin t) (k : J × Bool), T.p ∣ (T.ε k.1).eval (ξ e (T.φ k)) - 1)
    {q : Fin t → (MvPolynomial J O)[G]}
    (hq : ∀ e e' : Fin t, polyChar J (ξ e') (q e) = if e' = e then .C C else 0)
    (ty : J →o Fin t) {b : Fin t → ℕ∞}
    (hb : ∀ (e : Fin t) (Z : Submodule O (G → Unit → QuotSpan T.p)),
      (∀ c ∈ Z, IsCharacterCocycle T.u (ξ e) δ γ a c) →
      HasTriangleCost Z (fun j : J ↦ T.τ (j, true)) (fun j : J ↦ T.τ (j, false))
        (fun j : J ↦ T.φ (j, true)) (fun j : J ↦ T.φ (j, false)) {j : J | ty j = e} C (b e) ∧
        IsDetectedBy Z s) :
    ∃ (n : ℕ) (wt : Fin n → MvPolynomial J O)
      (M : Fin n → Matrix (W ⊕ s₀ ⊕ s) (W ⊕ s₀ ⊕ s) (MvPolynomial J O)[G]),
      (∀ (i : Fin n) (j : W ⊕ s₀ ⊕ s), M i j ∈ T.tiedRows (ribetGenerators δ s₀ s)) ∧
      ∃ Q : MvPolynomial J O,
        (∀ (F : MvPolynomial J O) {i : J →₀ ℕ}, i ≤ ∑ j : J, Finsupp.single j 1 →
          (F * ∑ k : Fin n, wt k * ∏ e : Fin t, ((M k).map (polyChar J (ξ e))).det).coeff i =
            if ∑ j : J, Finsupp.single j 1 = i then constantCoeff (F * Q) else 0) ∧
        addVal O (constantCoeff Q) ≤
          ∑ e : Fin t, b e + t * (∑ v : W, addVal O (eval 1 (o v)) + 2 * #s * addVal O C) +
            Fintype.card J * addVal O C := by
  let Λ : Type := MvPolynomial J O
  let η (e : Fin t) : Λ[G] →ₐ[Λ] Λ := polyChar J (ξ e)
  let N : Submodule Λ[G] (W ⊕ s₀ ⊕ s → Λ[G]) := T.tiedRows (ribetGenerators δ s₀ s)
  obtain ⟨ν, hν, hν_eq⟩ :=
    T.exists_unit_rows_mem_tiedRows hz hξγ hρ₀ hp fun e Z hZ ↦ (hb e Z hZ).2
  let K (e : Fin t) : Submodule Λ (s → Λ) := (N.restrictScalars Λ).map
    (vecMulLinear (fromRows (-of fun i j ↦ η e (ν i (inr (inr j)))) (1 : Matrix s s Λ)) ∘ₗ
      evalRowAtChar J (ξ e) W (s₀ ⊕ s))
  let 𝔮 (e : Fin t) : Ideal Λ := (nonDivisorIdeal O J).colon {∏ j with ty j < e, .X j}
  choose Γ hΓ_val hΓ using fun e : Fin t ↦
    T.exists_mem_fittingIdeal_character (ξ e) hz (hξγ e) hρ₀ hp ty e (hε e)
      (fun Z hZ ↦ (hb e Z hZ).1) ν
  choose d hd ζ hζ hdζ using fun e : Fin t ↦ mem_sup.1 (fittingIdeal.sup_smul_top_le (hΓ e))
  have h_expand (e : Fin t) : ∃ (l : ℕ) (w : Fin l → Λ) (B : Fin l → Matrix s s Λ),
      (∀ (i : Fin l) (j : s), ∃ b ∈ N,
        (∀ k : s₀, η e (b (inr (inl k))) = 0) ∧ (fun k : s ↦ η e (b (inr (inr k)))) = B i j) ∧
      ∑ i : Fin l, w i * (B i).det = d e := by
    obtain ⟨l, w, B, hB, hw⟩ := exists_sum_mul_det_of_mem_fittingIdeal_map (hd e)
    refine ⟨l, w, B, fun i j ↦ ?_, hw⟩
    obtain ⟨b, hb_mem, hb_eq⟩ := hB i j
    rw [← hb_eq]
    exact exists_row_apply_eq_zero (η e) hν (hν_eq e) hb_mem
  choose l w B hB hw using h_expand
  -- Choose one `B e (i e)` for each `e`, lift to `N`, and complete with the tame rows of `δ v`.
  let forget : (W ⊕ s₀ ⊕ s → Λ[G]) →ₗ[Λ[G]] s₀ ⊕ s → Λ[G] := LinearMap.funLeft _ _ inr
  let idx : Type := ∀ e : Fin t, Fin (l e)
  have h_several (i : idx) : ∃ M' : Matrix (s₀ ⊕ s) (s₀ ⊕ s) Λ[G],
      (∀ k : s₀ ⊕ s, ∃ r ∈ N, forget r = M' k) ∧
      ∀ e : Fin t, (M'.map (η e)).det = .C C ^ #s * (B e (i e)).det := by
    simpa using exists_rows_det_eq_pow_mul_det η (μ := fun _ ↦ .C C) hq (N.map forget)
      (fun e j ↦ ⟨forget (ν j), mem_map_of_mem (hν j), hν_eq e j⟩) (fun e ↦ B e (i e))
      fun e j ↦ by
        obtain ⟨b, hb_mem, hb_zero, hb_eq⟩ := hB e (i e) j
        exact ⟨forget b, mem_map_of_mem hb_mem, hb_zero, congrFun hb_eq⟩
  choose M' hM' hM'_det using h_several
  choose L hL hL_eq using hM'
  let M (i : idx) : Matrix (W ⊕ s₀ ⊕ s) (W ⊕ s₀ ⊕ s) Λ[G] :=
    of (Sum.elim (fun v ↦ Pi.single (inl v) (aeval (MonoidAlgebra.of Λ G (δ v)) (o v))) (L i))
  let c₀ : O := (∏ v : W, (o v).eval 1) * C ^ #s
  have hM (i : idx) (j : W ⊕ s₀ ⊕ s) : M i j ∈ N := by
    obtain v | k := j
    · exact T.single_mem_tiedRows (fun _ ↦ rfl) hδ_poly v
    · exact hL i k
  have hM_det (i : idx) (e : Fin t) : ((M i).map (η e)).det = .C c₀ * (B e (i e)).det := by
    have forget_L : (of fun k k' : s₀ ⊕ s ↦ L i k (inr k')) = M' i := funext (hL_eq i)
    rw [det_map_polyChar_tame_rows (fun v ↦ hξδ v e), forget_L, hM'_det, map_mul, map_pow,
      mul_assoc]
  -- Reindex `idx` to `Fin n` and fold the weighted determinant sum and valuation bound.
  let eqv : Fin (Fintype.card idx) ≃ idx := (Fintype.equivFin idx).symm
  have h_sum : ∑ k : Fin (Fintype.card idx),
      (∏ e : Fin t, w e (eqv k e)) * ∏ e : Fin t, ((M (eqv k)).map (η e)).det =
      MvPolynomial.C c₀ ^ t * ∏ e : Fin t, d e := by
    rw [Equiv.sum_comp eqv
      (fun i : idx ↦ (∏ e : Fin t, w e (i e)) * ∏ e : Fin t, ((M i).map (η e)).det)]
    calc _ = ∑ i : idx, MvPolynomial.C c₀ ^ t * ∏ e, w e (i e) * (B e (i e)).det := by
          refine Finset.sum_congr rfl fun i _ ↦ ?_
          simp only [hM_det, prod_mul_distrib, prod_const, card_univ, Fintype.card_fin]
          ring
      _ = MvPolynomial.C c₀ ^ t * ∏ e, ∑ j, w e j * (B e j).det := by
          rw [Fintype.prod_sum, Finset.mul_sum]
      _ = MvPolynomial.C c₀ ^ t * ∏ e, d e := by simp only [hw]
  refine ⟨Fintype.card idx, fun k ↦ ∏ e, w e (eqv k e), fun k ↦ M (eqv k),
    fun k j ↦ hM (eqv k) j, ⟨MvPolynomial.C c₀ ^ t * ∏ e, Γ e, fun F i hi ↦ ?_, ?_⟩⟩
  · rw [h_sum, ← mul_assoc, coeff_mul_prod_of_mem_colon ty hζ hdζ (F * MvPolynomial.C c₀ ^ t) hi,
      mul_assoc]
  · have h_card : ∑ e : Fin t, (#{j : J | ty j = e} : ℕ∞) = Fintype.card J := by
      rw [← Nat.cast_sum, ← card_eq_sum_card_fiberwise fun _ _ ↦ mem_univ _, card_univ]
    have hc₀ : addVal O c₀ = ∑ v : W, addVal O ((o v).eval 1) + #s * addVal O C := by
      simp [c₀, addVal_prod]
    have hΓ_prod : addVal O (MvPolynomial.constantCoeff (∏ e : Fin t, Γ e)) ≤
        ∑ e : Fin t, b e + (Fintype.card J + t * #s) * addVal O C := by
      rw [map_prod, addVal_prod]
      calc _ ≤ ∑ e : Fin t, (b e + (#{j : J | ty j = e} + #s) * addVal O C) :=
            sum_le_sum fun e _ ↦ hΓ_val e
        _ = _ := by simp [sum_add_distrib, ← sum_mul, h_card]
    calc addVal O (MvPolynomial.constantCoeff (MvPolynomial.C c₀ ^ t * ∏ e : Fin t, Γ e))
        = t * addVal O c₀ + addVal O (MvPolynomial.constantCoeff (∏ e : Fin t, Γ e)) := by
          simp only [map_mul, map_pow, MvPolynomial.constantCoeff_C, addVal_mul, addVal_pow,
            nsmul_eq_mul]
      _ ≤ t * addVal O c₀ + (∑ e, b e + (Fintype.card J + t * #s) * addVal O C) :=
          add_le_add le_rfl hΓ_prod
      _ = ∑ e, b e + t * (∑ v, addVal O ((o v).eval 1) + 2 * #s * addVal O C) +
            Fintype.card J * addVal O C := by
          rw [hc₀]
          ring

end Steps

